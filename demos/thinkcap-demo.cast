[0.6, "o", "\u001b[1;32m$\u001b[0m thinkcap version\n"]
[0.9, "o", "thinkcap \u001b[1;36m0.1\u001b[0m.\u001b[1;36m0\u001b[0m\r\n"]
[1.7, "o", "\u001b[1;32m$\u001b[0m thinkcap probe --mock --policy ./policy.json --budgets ./budgets.json\n"]
[2.1, "o", "\u001b[2mmock mode: profiling \u001b[0m\u001b[1;2;36m5\u001b[0m\u001b[2m canned responses \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mno live server\u001b[0m\u001b[1;2m)\u001b[0m\r\n\u001b[3m    thinkcap probe \u2014 suite 'coding-mini' vs     \u001b[0m\r\n\u001b[3m             http://localhost:8080              \u001b[0m\r\n\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n\u2503\u001b[1m \u001b[0m\u001b[1mtask_class\u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mn\u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mp50\u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mp90 (budget)\u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1msource\u001b[0m\u001b[1m \u001b[0m\u2503\r\n\u2521\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\r\n\u2502\u001b[36m \u001b[0m\u001b[36mbugfix    \u001b[0m\u001b[36m \u001b[0m\u2502 1 \u2502 263 \u2502\u001b[35m \u001b[0m\u001b[35m         263\u001b[0m\u001b[35m \u001b[0m\u2502 approx \u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[36m \u001b[0m\u001b[36mnew_file  \u001b[0m\u001b[36m \u001b[0m\u2502 1 \u2502 108 \u2502\u001b[35m \u001b[0m\u001b[35m         108\u001b[0m\u001b[35m \u001b[0m\u2502 approx \u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[36m \u001b[0m\u001b[36mrefactor  \u001b[0m\u001b[36m \u001b[0m\u2502 1 \u2502 288 \u2502\u001b[35m \u001b[0m\u001b[35m         288\u001b[0m\u001b[35m \u001b[0m\u2502 approx \u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[36m \u001b[0m\u001b[36mrename    \u001b[0m\u001b[36m \u001b[0m\u2502 2 \u2502  80 \u2502\u001b[35m \u001b[0m\u001b[35m          80\u001b[0m\u001b[35m \u001b[0m\u2502 approx \u2502\r\n\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\n\r\n\u001b[32mwrote\u001b[0m policy.json \u001b[1m(\u001b[0m\u001b[1;36m5\u001b[0m class budgets\u001b[1m)\u001b[0m \u001b[2mand appended observations to budgets.json\u001b[0m\r\n"]
[2.6, "o", "\u001b[1;32m$\u001b[0m cat policy.json\n"]
[2.9, "o", "{\r\n  \"version\": \"0.1.0\",\r\n  \"budgets\": [\r\n    {\r\n      \"task_class\": \"bugfix\",\r\n      \"budget_tokens\": 263,\r\n      \"source\": \"p90_observed\",\r\n      \"inception_token\": \" ...I have reasoned enough for this task. Acting now.\\n<|im_end|>\"\r\n    },\r\n    {\r\n      \"task_class\": \"new_file\",\r\n      \"budget_tokens\": 108,\r\n      \"source\": \"p90_observed\",\r\n      \"inception_token\": \" ...I have reasoned enough for this task. Acting now.\\n<|im_end|>\"\r\n    },\r\n    {\r\n      \"task_class\": \"refactor\",\r\n      \"budget_tokens\": 288,\r\n      \"source\": \"p90_observed\",\r\n      \"inception_token\": \" ...I have reasoned enough for this task. Acting now.\\n<|im_end|>\"\r\n    },\r\n    {\r\n      \"task_class\": \"rename\",\r\n      \"budget_tokens\": 80,\r\n      \"source\": \"p90_observed\",\r\n      \"inception_token\": \" ...I have reasoned enough for this task. Acting now.\\n<|im_end|>\"\r\n    },\r\n    {\r\n      \"task_class\": \"default\",\r\n      \"budget_tokens\": 2048,\r\n      \"source\": \"manual\",\r\n      \"inception_token\": \" ...I have reasoned enough for this task. Acting now.\\n<|im_end|>\"\r\n    }\r\n  ]\r\n}\r\n"]
[3.5, "o", "\u001b[1;32m$\u001b[0m thinkcap serve --policy ./policy.json --dry-run &\n"]
[3.8, "o", "\u001b[2m# starting the OpenAI-compatible proxy in dry-run (v0.1 advisory)...\u001b[0m\n"]
[4.1, "o", "INFO:     Started server process [22606]\nINFO:     Waiting for application startup.\nINFO:     Application startup complete.\nINFO:     Uvicorn running on http://0.0.0.0:8101 (Press CTRL+C to quit)\nINFO:     127.0.0.1:64307 - \"GET /health HTTP/1.1\" 200 OK\nINFO:     Shutting down\nINFO:     Waiting for application shutdown.\nINFO:     Application shutdown complete.\nINFO:     Finished server process [22606]\n"]
[4.5, "o", "\u001b[1;32m$\u001b[0m curl -s http://127.0.0.1:8101/health\n"]
[4.8, "o", "{\"status\":\"ok\",\"upstream\":\"http://localhost:8080\",\"enforce\":false,\"classes\":[\"bugfix\",\"new_file\",\"refactor\",\"rename\",\"default\"]}\n"]
[5.2, "o", "\n\u001b[1;36m# v0.1 ships the profiler. The governed turn (3,100 -> ~620 reasoning tokens,\n# same diff) reproduces against your live llama.cpp + Qwen3.8 server via\n# `thinkcap serve --accept` once the m3 parity suite passes.\u001b[0m\n"]
[5.6, "o", "\u001b[1;32m$\u001b[0m # repoint your coding agent: base_url=http://127.0.0.1:8101/v1\n"]
